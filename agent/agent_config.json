{
    "name": "LCAgent",
    "max_iterations": 200,
    "skills_dir": ".agents/skills",
    "auto_match_skills": true,
    "enable_mcp": true,
    "verbose": true,
    "mcp_config_file": "config/mcp_servers.json",
    "agent_prompt_file": "agent/AGENT.md",

    "max_execution_history": 100,
    "max_context_messages": 30,
    "context_trim_keep": 12,
    "tool_timeout": 120,
    "temperature": 0.7,
    "max_tokens": 8192,

    "memory_size": 10,
    "memory_buffer_delay_seconds": 20,
    "memory_max_buffer_messages": 30,
    "memory_max_facts_per_thread": 50,
    "memory_recall_limit": 10,
    "session_enable_memory": true
}

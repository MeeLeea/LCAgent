{
    "name": "LCAgent",
    "max_iterations": 200,
    "skills_dir": ".agents/skills",
    "auto_match_skills": true,
    "enable_mcp": true,
    "verbose": true,
    "mcp_config_file": "config/mcp_servers.json",
    "agent_prompt_file": "agent/AGENT.md",

    "max_execution_history": 100,
    "max_context_messages": 200,
    "context_trim_keep": 32,
    "tool_timeout": 60,
    "temperature": 0.7,
    "max_tokens": 10240,
    "latest_msg_cnt": 30
}
